{
  "Front matter": {
    "prefix": [
      "frontmatter",
      "---"
    ],
    "description": "Styled Markdown front matter",
    "body": [
      "---",
      "smd: 1",
      "title: ${1:Document title}",
      "summary: ${2:One or two sentences agents and humans read first.}",
      "status: ${3|draft,review,approved,deprecated,archived|}",
      "owners: [${4:@team}]",
      "tags: [${5}]",
      "updated: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "---",
      "",
      "$0"
    ]
  },
  "Callout": {
    "prefix": [
      "callout",
      ":::"
    ],
    "description": "Callout block (note, info, tip, success, warning, danger, question)",
    "body": [
      ":::${1|note,info,tip,success,warning,danger,question|} ${2:Title}",
      "${0:Content}",
      ":::"
    ]
  },
  "Collapsible callout": {
    "prefix": "callout-collapsible",
    "body": [
      ":::${1|note,info,tip,success,warning,danger,question|}{collapsible} ${2:Click to expand}",
      "${0:Content}",
      ":::"
    ]
  },
  "Details": {
    "prefix": "details",
    "body": [
      ":::details ${1:Summary}",
      "${0:Hidden content}",
      ":::"
    ]
  },
  "Card": {
    "prefix": "card",
    "body": [
      ":::card{accent=${1|indigo,blue,green,amber,red,purple,teal|}} ${2:Title}",
      "${0:Content}",
      ":::"
    ]
  },
  "Tabs": {
    "prefix": "tabs",
    "body": [
      "::::tabs",
      ":::tab ${1:First}",
      "${2}",
      ":::",
      ":::tab ${3:Second}",
      "${0}",
      ":::",
      "::::"
    ]
  },
  "Columns": {
    "prefix": "columns",
    "body": [
      "::::columns",
      ":::column",
      "${1:Left}",
      ":::",
      ":::column",
      "${0:Right}",
      ":::",
      "::::"
    ]
  },
  "Steps": {
    "prefix": "steps",
    "body": [
      ":::steps",
      "1. ${1:First step}",
      "2. ${2:Second step}",
      "3. ${0:Third step}",
      ":::"
    ]
  },
  "Agent block": {
    "prefix": [
      "agent",
      "ai"
    ],
    "description": "Content addressed to AI agents",
    "body": [
      ":::agent ${1:Instructions}",
      "- ${0:Constraint or instruction}",
      ":::"
    ]
  },
  "Human block": {
    "prefix": "human",
    "body": [
      ":::human ${1:Context}",
      "${0}",
      ":::"
    ]
  },
  "Styled box": {
    "prefix": "box",
    "body": [
      ":::box{bg=${1|indigo,blue,green,amber,red,purple,teal,gray|} align=${2|left,center,right|}}",
      "${0}",
      ":::"
    ]
  },
  "Colored text": {
    "prefix": [
      "color",
      "span"
    ],
    "body": [
      "[${1:text}]{color=${2|red,orange,amber,green,teal,blue,indigo,purple,pink,gray|}}$0"
    ]
  },
  "Badge": {
    "prefix": "badge",
    "body": [
      ":badge[${1:Label}]{color=${2|green,amber,red,blue,purple,gray|}}$0"
    ]
  },
  "Status": {
    "prefix": "status",
    "body": [
      ":status[${1:On track}]{color=${2|green,amber,red,gray|}}$0"
    ]
  },
  "Progress": {
    "prefix": "progress",
    "body": [
      ":progress{value=${1:50}}$0"
    ]
  },
  "Keyboard": {
    "prefix": "kbd",
    "body": [
      ":kbd[${1:Ctrl+S}]$0"
    ]
  },
  "Mermaid flowchart": {
    "prefix": [
      "mermaid",
      "flowchart"
    ],
    "body": [
      "```mermaid",
      "flowchart ${1|LR,TD|}",
      "    A[${2:Start}] --> B{${3:Decision}}",
      "    B -- yes --> C[${4:Do it}]",
      "    B -- no --> D[${5:Skip}]",
      "```",
      "$0"
    ]
  },
  "Mermaid sequence": {
    "prefix": "sequence",
    "body": [
      "```mermaid",
      "sequenceDiagram",
      "    participant ${1:A}",
      "    participant ${2:B}",
      "    $1->>$2: ${3:Request}",
      "    $2-->>$1: ${4:Response}",
      "```",
      "$0"
    ]
  },
  "Mermaid gantt": {
    "prefix": "gantt",
    "body": [
      "```mermaid",
      "gantt",
      "    title ${1:Roadmap}",
      "    dateFormat YYYY-MM-DD",
      "    section ${2:Phase 1}",
      "    ${3:Task} :a1, $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE, 14d",
      "    ${4:Next task} :after a1, 7d",
      "```",
      "$0"
    ]
  },
  "Mermaid pie": {
    "prefix": "pie",
    "body": [
      "```mermaid",
      "pie title ${1:Title}",
      "    \"${2:A}\" : ${3:60}",
      "    \"${4:B}\" : ${5:40}",
      "```",
      "$0"
    ]
  },
  "Math block": {
    "prefix": "math",
    "body": [
      "$$",
      "${0}",
      "$$"
    ]
  },
  "Code with title": {
    "prefix": "code",
    "body": [
      "```${1:ts} title=\"${2:src/file.ts}\"",
      "${0}",
      "```"
    ]
  },
  "Task list": {
    "prefix": "tasks",
    "body": [
      "- [ ] ${1:Task}",
      "- [ ] ${2:Task}",
      "- [x] ${0:Done task}"
    ]
  },
  "Table": {
    "prefix": "table",
    "body": [
      "| ${1:Column} | ${2:Column} |",
      "| --- | --- |",
      "| ${3} | ${0} |"
    ]
  },
  "Decision": {
    "prefix": [
      "decision",
      "adr"
    ],
    "description": "Decision record",
    "body": [
      ":::decision{status=${1|proposed,accepted,rejected,superseded,deprecated|} date=$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE owner=${2:@owner}} ${3:What we decided}",
      "${4:Why, and the alternatives considered.}",
      ":::"
    ]
  },
  "Risk": {
    "prefix": "risk",
    "body": [
      ":::risk{impact=${1|low,medium,high,critical|} likelihood=${2|low,medium,high|} owner=${3:@owner}} ${4:What could go wrong}",
      "${5:Mitigation}",
      ":::"
    ]
  },
  "Risk matrix": {
    "prefix": [
      "risk-matrix",
      "riskmatrix"
    ],
    "description": "Impact × likelihood matrix of the risks in this document",
    "body": [
      ":::risk-matrix ${1:Risks}",
      ":::"
    ]
  },
  "API endpoint": {
    "prefix": [
      "api",
      "endpoint"
    ],
    "body": [
      ":::api{method=${1|GET,POST,PUT,PATCH,DELETE|} path=\"${2:/v1/items}\"} ${3:Description}",
      "| Param | Type | Required | Notes |",
      "| --- | --- | --- | --- |",
      "| ${4:id} | ${5:string} | yes | |",
      "",
      "**Responses:** `200` ${6:OK} · `404` Not found",
      ":::"
    ]
  },
  "Timeline": {
    "prefix": [
      "timeline",
      "milestones"
    ],
    "body": [
      ":::timeline",
      "- **${1:2026-10-01}** — ${2:Beta}",
      "- **${3:2026-11-01}** — ${4:GA}",
      ":::"
    ]
  },
  "Figure": {
    "prefix": [
      "figure",
      "caption"
    ],
    "description": "Numbered figure with a caption around an image, diagram, table (kind=table) or code (kind=listing)",
    "body": [
      ":::figure{#${1:fig-id}} ${2:Caption}",
      "${0:![Alt text](image.png)}",
      ":::"
    ]
  },
  "Figure reference": {
    "prefix": [
      "ref",
      "figref"
    ],
    "description": "Numbered reference to a figure by id: renders \"Figure 2\" as a link to it",
    "body": ":ref[${1:fig-id}]"
  },
  "Priority": {
    "prefix": "priority",
    "body": [
      ":priority[${1|P0,P1,P2,P3|}]$0"
    ]
  },
  "Due date": {
    "prefix": "due",
    "body": [
      ":due[${1:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}]$0"
    ]
  },
  "Metric": {
    "prefix": [
      "metric",
      "kpi"
    ],
    "body": [
      ":metric[${1:42%}]{label=\"${2:Activation}\" delta=\"${3:+3%}\" trend=${4|up,down,flat|}}$0"
    ]
  },
  "Task with owner": {
    "prefix": "task",
    "body": [
      "- [ ] ${1:Task} :priority[${2|P0,P1,P2,P3|}] ${3:@owner} :due[${4:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}]"
    ]
  },
  "Embed source file": {
    "prefix": [
      "embed",
      "include"
    ],
    "body": [
      "```${1:ts} file=\"${2:../src/index.ts}\" lines=\"${3:1-20}\"",
      "```"
    ]
  },
  "Include another document": {
    "prefix": [
      "transclude",
      "include-doc"
    ],
    "body": [
      ":::include{file=\"${1:shared/terms.smd}\" section=\"${2:Pricing}\"}",
      "See [${2:Pricing}](${1:shared/terms.smd}).",
      ":::",
      "$0"
    ]
  },
  "Section hidden from agents": {
    "prefix": "skip",
    "body": [
      "## ${1:Background} {agent=skip}",
      "",
      "$0"
    ]
  }
}
