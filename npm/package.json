{
  "name": "styled-markdown",
  "version": "1.7.0",
  "description": "Styled Markdown (.smd): Markdown for developers, PMs and AI agents. Render, validate, convert and create token-efficient agent views — library + `smd` CLI, zero dependencies.",
  "author": "Roshan Alwis",
  "license": "MIT",
  "homepage": "https://github.com/bislink360/styled-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bislink360/styled-markdown.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/bislink360/styled-markdown/issues"
  },
  "keywords": [
    "markdown",
    "smd",
    "styled-markdown",
    "documentation",
    "mermaid",
    "katex",
    "validator",
    "cli",
    "ai-agents",
    "llm",
    "tokens",
    "prd",
    "adr",
    "markdown-it",
    "markdown-it-plugin",
    "remark",
    "rehype",
    "unified",
    "remark-plugin",
    "lsp",
    "language-server"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./markdown-it": {
      "types": "./dist/types/markdownIt.d.ts",
      "import": "./dist/markdown-it.mjs",
      "require": "./dist/markdown-it.cjs"
    },
    "./remark": {
      "types": "./dist/types/remark.d.ts",
      "import": "./dist/remark.mjs",
      "require": "./dist/remark.cjs"
    },
    "./rehype": {
      "types": "./dist/types/rehype.d.ts",
      "import": "./dist/rehype.mjs",
      "require": "./dist/rehype.cjs"
    },
    "./smd.css": "./dist/smd.css",
    "./frontmatter.schema.json": "./dist/frontmatter.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "smd": "dist/cli.js",
    "smd-language-server": "dist/language-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "markdown-it": ">=13"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
