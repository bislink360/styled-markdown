  "license": "MIT",
  "keywords": [
    "styled-markdown",
    "smd",
    "markdown",
    "specs",
    "documentation",
    "mcp",
    "tokens"
  ],
  "mcpServers": {
    "smd": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/skills/styled-markdown-reader/scripts/smd.cjs",
