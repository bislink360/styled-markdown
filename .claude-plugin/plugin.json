{
  "name": "styled-markdown",
  "displayName": "Styled Markdown",
  "version": "2.5.1",
  "description": "Read and write Styled Markdown (.smd) specs, PRDs, ADRs, runbooks and plans with fewer tokens: the reader and writer skills plus the smd MCP server (read, tasks, query, validate).",
  "author": {
    "name": "Roshan Alwis",
